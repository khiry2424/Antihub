{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Hub",
  "version": "1.0.0",
  "identifier": "com.antigravity.multiaccounthub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Multi-Account Hub",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icons/AntigravityHub.ico"
    ]
  }
}
